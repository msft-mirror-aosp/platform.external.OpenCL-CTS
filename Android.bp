python_test_host {
    name: "opencl_cts",
    main: "scripts/test_opencl_cts.py",
    srcs: ["scripts/test_opencl_cts.py"],
    data: [
        ":ocl-test-allocations",
        ":ocl-test-api",
        ":ocl-test-atomics",
        ":ocl-test-basic",
        ":ocl-test-buffers",
        ":ocl-test-c11-atomics",
        ":ocl-test-commonfns",
        ":ocl-test-compiler",
        ":ocl-test-computeinfo",
        ":ocl-test-contractions",
        ":ocl-test-conversions",
        ":ocl-test-device-execution",
        ":ocl-test-device-partition",
        ":ocl-test-device-timer",
        ":ocl-test-events",
        ":ocl-test-generic-address-space",
        ":ocl-test-geometrics",
        ":ocl-test-half",
        ":ocl-test-integer-ops",
        ":ocl-test-math-brute-force",
        ":ocl-test-mem-host-flags",
        ":ocl-test-multiple-device-context",
        ":ocl-test-non-uniform-work-group",
        ":ocl-test-pipes",
        ":ocl-test-printf",
        ":ocl-test-profiling",
        ":ocl-test-relationals",
        ":ocl-test-select",
        ":ocl-test-spir",
        ":ocl-test-spirv-new",
        ":ocl-test-subgroups",
        ":ocl-test-svm",
        ":ocl-test-thread-dimensions",
        ":ocl-test-vectors",
        ":ocl-test-image-clcopyimage",
        ":ocl-test-image-clfillimage",
        ":ocl-test-image-clgetinfo",
        ":ocl-test-image-clreadwriteimage",
        ":ocl-test-image-kernel-image-methods",
        ":ocl-test-image-kernel-read-write",
        ":ocl-test-image-samplerlessreads",
    ],
    test_config: "scripts/test_opencl_cts.xml",
    test_options: {
        unit_test: false,
    },
}

python_test {
