    </test>
    <test class="com.android.tradefed.testtype.binary.ExecutableTargetTest">
        <option name="per-binary-timeout" value="1m"/>
        <option name="test-command-line" key="geom_fast_normalize" value="CL_WIMPY_MODE=1 /data/nativetest64/unrestricted/OpenCL-CTS/*/OpenCL-CTS-test_geometrics geom_fast_normalize"/>
    </test>
    <test class="com.android.tradefed.testtype.binary.ExecutableTargetTest">
        <option name="per-binary-timeout" value="1m"/>
        <option name="test-command-line" key="geom_length" value="CL_WIMPY_MODE=1 /data/nativetest64/unrestricted/OpenCL-CTS/*/OpenCL-CTS-test_geometrics geom_length"/>
    </test>
    <test class="com.android.tradefed.testtype.binary.ExecutableTargetTest">
        <option name="per-binary-timeout" value="1m"/>
        <option name="test-command-line" key="geom_normalize" value="CL_WIMPY_MODE=1 /data/nativetest64/unrestricted/OpenCL-CTS/*/OpenCL-CTS-test_geometrics geom_normalize"/>
    </test>
</configuration>
